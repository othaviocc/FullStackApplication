# Copie para .env e ajuste conforme necessario.

# Responde as buscas com dados locais, sem depender do back-end.
# Deixe "false" assim que a API estiver no ar.
VITE_USAR_MOCK=true

# Caminho base da API. O padrao "/api" funciona tanto no Docker (proxy do
# nginx) quanto em desenvolvimento (proxy do Vite).
VITE_API_URL=/api
